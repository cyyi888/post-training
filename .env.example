# 复制为 .env 后填写（.env 已在 .gitignore，不要提交密钥）
#   cp .env.example .env

# HuggingFace 镜像（国内服务器常用）
HF_ENDPOINT=https://hf-mirror.com

# WandB：在 https://wandb.ai/authorize 复制 API Key
# 设置后无需再交互执行 wandb login
WANDB_API_KEY=

# 可选：默认项目（也可在命令行 wandb.project=xxx 覆盖）
WANDB_PROJECT=posttrainlab

# 可选：离线模式时设为 offline；在线训练保持 online 或留空
# WANDB_MODE=online
